msgstr "- REST-Route:"

msgid ""
"- Reproduce this URL/action and temporarily disable recently added/updated "
"plugins"
msgstr ""
"- Diese URL/Aktion reproduzieren und kürzlich hinzugefügte/aktualisierte "
"Plugins vorübergehend deaktivieren"

msgid "- Type:"
msgstr "- Typ:"

msgid "- URI:"
msgstr "- URI:"

